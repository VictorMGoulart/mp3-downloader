# ------------------------------------------------------------------
# Copie para .env (ou .env.local) e ajuste. Em PaaS (Render, Railway,
# Fly.io, etc.) defina as mesmas chaves no painel de variáveis.
# Todas são opcionais; os valores abaixo são os padrões.
# ------------------------------------------------------------------

# --- Servidor ---
NODE_ENV=development            # "production" ativa padrões seguros (rate limit, trust proxy)
PORT=3000
HOST=0.0.0.0
# TRUST_PROXY=true              # padrão: true em produção. Necessário atrás de proxy reverso
# CORS_ORIGINS=                 # ex.: https://meusite.com,https://www.meusite.com (vazio = mesma origem)

# --- Armazenamento ---
# DATA_DIR=                     # dev: ./tmp_downloads · prod: <tmp do SO>/mp3-downloader
JOB_TTL_MINUTES=60              # por quanto tempo o ZIP fica disponível

# --- Limites (importante em site público) ---
MAX_TRACKS_PER_JOB=0               # músicas por download (0 = sem limite)
MAX_PLAYLIST_ITEMS=0               # faixas lidas da playlist (0 = sem limite)
MAX_CONCURRENT_JOBS=2
# RATE_LIMIT_MAX=20             # requisições por IP por janela (padrão: 0 em dev, 20 em prod)
RATE_LIMIT_WINDOW_MINUTES=15

# --- yt-dlp ---
# YTDLP_PATH=yt-dlp             # caminho do binário, se não estiver no PATH
# FFMPEG_LOCATION=              # caminho do ffmpeg, se não estiver no PATH
# YTDLP_PROXY=                  # ex.: http://user:pass@host:port ou socks5://host:port
# YTDLP_PLAYER_CLIENT=          # ex.: default,mweb (vazio = padrão do yt-dlp)
# YTDLP_PO_TOKEN=               # ex.: mweb.gvs+TOKEN (ver docs/DEPLOY.md)
# YTDLP_EXTRA_ARGS=             # ex.: --sleep-requests 1 --retries 5
YTDLP_TOPIC_LOOKUP=true         # busca metadados do YouTube Music (1–2 chamadas por faixa); false = só título
YTDLP_TOPIC_LOOKUP_CONCURRENCY=4   # processos do yt-dlp em paralelo buscando metadados
YTMUSIC_FALLBACK=true           # faixa indisponível → baixa a versão equivalente que o YouTube Music toca no lugar
YTDLP_METADATA_BATCH_SIZE=5        # faixas por processo (agrupar evita ~1,5 s de inicialização por faixa)
METADATA_CACHE_SIZE=5000           # vídeos com metadados em cache (0 desativa)
METADATA_CACHE_TTL_HOURS=24
YTDLP_SLEEP_BETWEEN_MS=0        # pausa entre downloads (ajuda a evitar bloqueio)
# YTDLP_PLAYLIST_TIMEOUT_MS=120000
# YTDLP_DOWNLOAD_TIMEOUT_MS=600000
# YTDLP_DOWNLOAD_CONCURRENCY=3   # faixas baixadas em paralelo por job (mais = mais rápido, mais chance de bloqueio do YouTube)
# YTDLP_DOWNLOAD_RETRIES=2       # novas tentativas por faixa em falhas passageiras (403, timeout, arquivo bloqueado)
# YTDLP_TOPIC_LOOKUP_TIMEOUT_MS=15000

# Docker: atualiza o yt-dlp a cada start do container (recomendado; o YouTube muda com frequência)
YTDLP_AUTO_UPDATE=true

# --- Cookies do YouTube (use só UMA das opções) ---
# Geralmente necessários em servidores na nuvem. Use uma conta descartável.
# COOKIES_PATH=./cookies.txt    # arquivo no formato Netscape
# COOKIES_BASE64=               # conteúdo do cookies.txt em base64 (recomendado em PaaS)
# COOKIES_TXT=                  # conteúdo bruto (aceita \n literal)
