{
    "name": "youtube-mp3-downloader",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "dev": "concurrently -k -n api,web -c gray,blue \"tsx watch src/server.ts\" \"vite --config web/vite.config.mts\"",
        "dev:api": "tsx watch src/server.ts",
        "dev:web": "vite --config web/vite.config.mts",
        "build": "vite build --config web/vite.config.mts && tsc",
        "start": "node dist/server.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit && tsc --noEmit -p web"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.12",
        "@types/archiver": "^7.0.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/node": "^25.5.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^4.7.0",
        "concurrently": "^9.2.5",
        "jsdom": "^25.0.1",
        "prettier": "^3.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vite": "^6.4.6",
        "vitest": "^3.2.7"
    },
    "dependencies": {
        "archiver": "^7.0.1",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^4.21.2",
        "undici": "^7.30.2"
    }
}
