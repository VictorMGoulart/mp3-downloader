# Copie para /opt/apps/mp3/.env na VM (chmod 600). Lista completa de variáveis em .env.example.
# O site é público (sem login). As proteções abaixo evitam que um visitante derrube a VM,
# que é compartilhada com o Dashboard BTC.

# Atrás do Cloudflare Tunnel. O IP do visitante vem do CF-Connecting-IP, que a Cloudflare
# sempre reescreve (não dá para forjar). Seguro porque nenhum tráfego chega sem passar por ela.
TRUST_PROXY=true
CLIENT_IP_HEADER=cf-connecting-ip

# Por visitante: 20 buscas/downloads a cada 15 min.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MINUTES=15

# Não começa (nem continua) downloads com menos de 3 GB livres no disco da VM.
MIN_FREE_DISK_MB=3072

# A VM é compartilhada com o BTC (2 GB de RAM): um download por vez, 2 faixas em paralelo.
MAX_CONCURRENT_JOBS=1
YTDLP_DOWNLOAD_CONCURRENCY=2
# 0 = sem limite. Cada faixa ocupa ~8 MB em disco até o ZIP ser descartado.
MAX_TRACKS_PER_JOB=0
# ZIP pronto fica disponível por 30 min sem uso (libera disco mais cedo que o padrão de 60).
JOB_TTL_MINUTES=30

# Atualiza o yt-dlp a cada start do container (o YouTube muda com frequência).
YTDLP_AUTO_UPDATE=true

# --- O YouTube bloqueia IPs da AWS ("Sign in to confirm you're not a bot") ---
# Proxy residencial com sessão fixa (sticky): o link do áudio vale só para o IP que o pediu,
# então o IP não pode trocar no meio de um download. Também é usado na consulta ao
# YouTube Music, por isso precisa ser HTTP/HTTPS (não SOCKS).
# YTDLP_PROXY=http://usuario:senha@host:porta
# Alternativa grátis: cookies de uma conta descartável, exportados em formato Netscape.
# COOKIES_BASE64=
